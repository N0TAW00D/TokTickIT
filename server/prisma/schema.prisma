// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Evolved from Lab 2's `RequesterUser` (docs/lab-03/specification.md §7.1,
// §7.4 item 1): the migration renames the table so every existing row, id
// and foreign key survives untouched. Now models all three Lab 3 roles, not
// only Requesters.
model User {
  id   Int    @id @default(autoincrement())
  name String

  // Case-insensitively unique and stored lower-cased (BR-09). Deliberately
  // NOT declared `@unique` here: Prisma's own diffing has no representation
  // for the case-insensitive unique index this needs, so the constraint is
  // hand-written as `CREATE UNIQUE INDEX ... ON "User" (lower(email))` in
  // migration SQL instead (specification.md §7.4 item 6). Adding `@unique`
  // to this field would make Prisma start managing its own case-*sensitive*
  // unique constraint on the next `prisma migrate dev`, silently
  // reintroducing the duplicate-email hole this design avoids — don't.
  email String

  // bcrypt hash, cost 12 (BR-06). Never a plaintext password.
  passwordHash String

  role Role @default(REQUESTER)

  isActive Boolean @default(true)

  // Cleared once a valid new password is saved (FR-07). Defaults true so a
  // freshly migrated Lab 2 Requester, and every seeded/created account,
  // must choose a real password before entering the application.
  mustChangePassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedTickets   Ticket[]        @relation("TicketRequester")
  ownedTickets       Ticket[]        @relation("TicketOwner")
  removedAttachments Attachment[]    @relation("AttachmentRemovedBy")
  sessions           Session[]
  publicComments     PublicComment[]
  internalNotes      InternalNote[]

  // --- Lab 4 (specification.md §7.2) ---
  actionsPerformed    ActionTaken[]        @relation("ActionPerformedBy")
  actionsAssigned     ActionTaken[]        @relation("ActionAssignee")
  actionsLastUpdated  ActionTaken[]        @relation("ActionLastUpdatedBy")
  ticketStatusChanges TicketStatusChange[]

  // Administrator role filter and the last-active-Administrator check
  // (BR-32).
  @@index([role, isActive])
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// New in Lab 3 (specification.md §7.1). The cookie carries only the raw
// 256-bit token, base64url-encoded; `tokenHash` stores its SHA-256 hash, so
// a database leak yields no usable session.
model Session {
  tokenHash String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Bulk invalidation on logout-all and deactivation (BR-12).
  @@index([userId])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority Priority
  status            TicketStatus @default(NEW)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // --- Lab 3 additions (specification.md §7.1) ---

  // Primary Ticket Owner; null = unassigned (BR-19).
  ownerId Int?

  // Initialised to a copy of requestedPriority (BR-22) and afterwards
  // changed only by IT Staff or Administrator, independently of
  // requestedPriority.
  itPriority Priority

  // Set by "Problem Appears Resolved" (BR-26); does not change status.
  requesterResolvedAt DateTime?

  // --- Lab 4 addition (specification.md §7.1, BR-33) ---

  // Optimistic-concurrency counter: changes exactly when a guarded field
  // (status, owner, IT Priority) changes. Every pre-Lab-4 row becomes 1.
  version Int @default(1)

  requester      User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner          User?           @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem  RelatedSystem   @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]

  actionsTaken  ActionTaken[]
  statusChanges TicketStatusChange[]

  @@index([requesterId, createdAt])
  @@index([requesterId, updatedAt])
  @@index([requesterId, ticketNumber])
  @@index([categoryId])
  // Default queue ordering: IT Priority desc, created date asc (§8.2, D-10).
  @@index([itPriority, createdAt])
  // Queue filter by status.
  @@index([status])
  // Queue filter by owner, including "unassigned".
  @@index([ownerId])
  // Recent-window and by-status dashboard queries (§7.3).
  @@index([status, updatedAt])
  // Owned by Me / Unassigned dashboard counts (§7.3).
  @@index([ownerId, status])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  fileSize         Int
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removedReason    String?
  removedById      Int?
  createdAt        DateTime  @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  removedBy User?  @relation("AttachmentRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([ticketId, isRemoved])
}

// New in Lab 3 (specification.md §7.1). Visible to the owning Requester, IT
// Staff and Administrator (BR-04). Append-only (BR-15).
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Thread retrieval in order.
  @@index([ticketId, createdAt])
}

// New in Lab 3 (specification.md §7.1). Visible only to IT Staff and
// Administrator (BR-04). Append-only (BR-15).
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Thread retrieval in order.
  @@index([ticketId, createdAt])
}

// New in Lab 4 (specification.md §7.1). Editable by IT Staff (not deleted).
// The follow-up consistency CHECK constraint is hand-written in the Lab 4
// migration SQL (§7.4 item 2): Prisma cannot express it and does not diff it.
model ActionTaken {
  id                Int          @id @default(autoincrement())
  ticketId          Int
  actionAt          DateTime
  description       String
  result            String?
  status            ActionStatus @default(PLANNED)
  performedById     Int
  assigneeId        Int?
  followUpRequired  Boolean      @default(false)
  followUpNote      String?
  attachmentNotes   String?
  lastUpdatedById   Int
  // Idempotency key and canonical-body hash (BR-35).
  clientRequestId   String?
  clientRequestHash String?
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  performedBy   User   @relation("ActionPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  assignee      User?  @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  lastUpdatedBy User   @relation("ActionLastUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: Restrict)

  // Idempotent create (BR-35); NULLs are distinct in Postgres.
  @@unique([ticketId, clientRequestId])
  // Ticket Detail list in BR-14 order.
  @@index([ticketId, actionAt, id])
  // Resolution gate (BR-17) and the Open Actions count.
  @@index([ticketId, status])
  // My Open Actions (BR-25).
  @@index([assigneeId, status])
  @@index([performedById, status])
  // Follow-ups Required (BR-26).
  @@index([ticketId, followUpRequired])
}

// New in Lab 4 (specification.md §7.1). Append-only (BR-19).
model TicketStatusChange {
  id          Int          @id @default(autoincrement())
  ticketId    Int
  fromStatus  TicketStatus
  toStatus    TicketStatus
  changedById Int
  changedAt   DateTime     @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  // History order (BR-14).
  @@index([ticketId, changedAt, id])
  // Recently Resolved (BR-23).
  @@index([toStatus, changedAt])
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TicketCounter {
  year      Int @id
  lastValue Int @default(0)
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Extended in Lab 3 from the single Lab 2 value to the eight statuses in
// the §5.1 transition matrix. Every existing Lab 2 ticket stays `NEW`,
// which remains valid (specification.md §7.4 item 7).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}
